# minimax31-flash TP=3 cluster env -- the serving profile of record.
#
# Every value below is the measured optimum for THIS stack (3x NVIDIA DGX
# Spark GB10, MiniMax M3.1 Flash, DSpark k=3 speculative decode, CUDA-graph
# capture grid capped at 128); the comments carry the rounded verdicts from
# docs/FIXLOG.md.
#
# EDIT the blocks marked EDIT for your site; everything else is pinned to the
# validated profile. The launch scripts read these as environment variables;
# sourcing this file on each box is enough.
#
#   RECIPE_DIR=~/MiniMax-M3.1-Flash-TP3-3x-DGX-Spark   # your clone
#   set -a; . "$RECIPE_DIR/config/cluster.env"; set +a

# --- kit identity (the manifest's own digest, over a SECOND CHANNEL).
# A manifest cannot contain its own hash, so a box carrying a stale kit AND a
# stale manifest would verify against itself -- and would serve an older
# recipe without saying so. launch/boot-tp3.sh and tools/capture-config.sh
# pass this value to kit-md5.py, so a stale manifest is a BOOT FAILURE rather
# than a silent downgrade.
#
# THIS IS THE DIGEST OF THE MANIFEST THAT SHIPS WITH THIS RECIPE. Recompute it
# with `md5sum kit-md5.txt` (`md5 -q kit-md5.txt` on macOS) in the recipe root
# whenever a kit file changes
# (`python3 kit-md5.py --write` regenerates the manifest itself).
#
# WHAT THIS DOES NOT COVER: the digest travels INSIDE the checkout, so a box
# whose kit, manifest AND this file are all stale is self-consistent and boots
# happily. Step 4 of the README -- comparing each box's manifest digest
# against the repo's, FROM THE REPO -- is what catches that case. A second
# channel has to live outside the thing it is checking.
KIT_MANIFEST_MD5=4d3fd6e255ea66462fde7f336815e416

# --- checkpoint (EDIT: identical staging on all three boxes).
# The snapshot is ~233 GiB of already-quantized tensors (MXFP8 dense +
# NVFP4-packed MoE experts), so stage it once and copy it box-to-box; the
# in-checkpoint DSpark draft head rides along under <model>/dspark and needs
# no second download.
#
# These three are the DOWNLOAD COORDINATES, not launch knobs: the launch
# mounts MODEL_DIR read-only and never fetches anything. The README's stage
# step reads them, so editing them changes what gets downloaded.
MODEL_REPO=MiniMaxAI/MiniMax-M3.1-Flash
MODEL_REVISION=54e4e69dfc452b1e94a426c24a4fdeeaa8e3ad5e
MODEL_DIR=~/models/minimax31-flash-54e4e69dfc45

# --- runtime image (EDIT: your own build if you mirror it).
# The upstream day-0 build for this model on arm64 / CUDA 13.4 ships NO ray,
# and the multi-node executor needs one; launch/Dockerfile adds it as a
# single layer. Re-pin the digest only after re-validating patches/ against
# the new tree (see patches/README.md).
#
# These two are the BUILD's inputs: launch/Dockerfile takes them as build
# arguments, and the README's build step passes them, so editing them
# changes what is built rather than being a comment next to a hardcode.
VLLM_BASE_IMAGE=vllm/vllm-openai@sha256:5d76347628973fb80519a919a2f2740b6645b62cba3fe2bd87b25f111bd0e948
VLLM_TAG=minimax31-flash-tp3
RAY_VERSION=2.59.0

# --- TP=3 ring (EDIT: your three boxes).
# Every rank talks to BOTH peers: the full triangle is required, not a chain.
# Boot gate: all three ranks join the ring before anything else is diagnosed.
#
# ONE ADDRESS IS EDITED HERE: the head's. Every box reads this same file, so
# a per-box address CANNOT live in it -- the three boxes have different ones.
# Each box's OWN address comes from its hostname: launch/boot-tp3.sh maps
# spark-head*/spark-a*/spark-b* to the role, the rank and the address. An
# explicit ROLE=... NODE_RANK=... NODE_IP=... in the environment WINS over
# that map, so a box with an unusual name is still expressible.
HEAD_IP=192.168.0.10
# The rendezvous port is the executor's own TCPStore; it is NOT the API port.
DIST_MASTER_PORT=25000
# The API port. It is this recipe's own port and is free to choose.
PORT=8100
# The ring's size and the tensor-parallel width. These are the LIVE names the
# launch scripts read (TP and CLUSTER_SIZE) -- the shape of this recipe is
# 3x3 by construction, and changing them changes what the engine is asked to
# do, not how it is addressed.
TP=3
CLUSTER_SIZE=3

# --- the model geometry, and the divisibility wall.
# The checkpoint's own attention geometry is 64 query heads / 4 KV heads /
# 4 index heads, and the engine requires each of those to divide by the
# tensor-parallel size. 64 % 3 != 0, so the model cannot be sharded across
# three ranks as published. The recipe's answer is a ratio-preserving
# append-only pad to 96 / 6 / 6 (16 query heads per KV head before and
# after), applied by patches/ at every boot. See patches/README.md.
#
# The pad is APPLIED, not configured. launch/start-tp3.sh passes the tensor-
# parallel WIDTH to the container as VLLM_TP3_PAD, because the overlay reads
# that variable as the width -- a value of 1 would mean "TP=1", which is a
# different model shape and no padding at all. It is derived from TP, so it
# is deliberately NOT a knob here.
#
# Which model types the pad applies to IS a knob, and it is read.
VLLM_TP3_PAD_MODEL_TYPES=minimax_m3_vl,minimax_m3_dspark

# --- the serving profile.
# 0.80 is the budget this stack holds with a guard floor on every box WHEN
# the model boxes carry only their light GPU tenants (the head bare; one
# rank an embedder; another a small service). The budget is bounded by HOST
# headroom, not by a knob: the same 0.80 in a layout where the boxes also
# carry heavier co-tenant services (a chat UI, document parsing, speech
# services) does NOT hold -- that layout's tightest box lands under its
# floor, and the guard (correctly) kills the lane. That documented failure
# set the earlier, conservative 0.78; this profile targets a layout where
# heavier services live off the model boxes. See docs/FIXLOG.md for both
# sides of the arithmetic.
GMU=0.80
# The context the lane serves. The model's native class is 1M, but the
# served context is what the KV pool can hold, and the ENGINE'S OWN
# concurrency figure is a property of (pool / request length): the same
# pool reads differently against each denominator, because a full-length
# request uses almost all of it. That denominator dependence is the classic
# footgun of this recipe, and the capture gate checks the engine's OWN
# max_seq_len and the denominator of its concurrency figure, not what was
# intended.
#
# THE POOL AT 0.80, and the price, named: the engine's own boot figure is
# the verdict, and at this budget the pool reads roughly 266,000 tokens --
# about 2.0x at a 131,072-token request and about 1.35x at 196,608. A
# 262,144-token request now FITS the pool (it did not at 0.78) but leaves
# almost no concurrency, so the served context stays 196,608: the
# denominator is a choice, not a ceiling. One full-length 196,608 request
# is still the honest shape of this lane; two of them need ~393,216 tokens
# and remain out of reach on this checkpoint's own size.
CTX=196608
# The capture grid. Capping the PIECEWISE grid at 128 removes the oversized
# prefill/mixed graphs the lane never replays as decode graphs, and the freed
# capture estimate becomes KV capacity at (approximately) zero price in host
# memory. With the cap in force the engine reports 19 PIECEWISE graphs,
# 17 FULL decode graphs and 14 draft descriptors, and the capture pool is
# under 1 GiB per rank against an estimate of about 2 GiB.
#
# UNSET is the engine's own default grid and is NOT this recipe's profile --
# it costs about 15,000 tokens of KV pool (about 8% of what the pool would
# have been without the cap) for graphs the lane never uses.
CGCAP="[1,2,4,8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128]"

# --- speculative decode.
# The DSpark draft head ships inside the checkpoint. k=3, probabilistic draft
# sampling and block rejection sampling. The draft head is padded to TP=3 by
# the same kit as the target (the draft is 64/4 as published), which the
# boot-time gate proves before the engine starts.
#
# This is the file the launch reads -- one file, read once, and handed to the
# engine and to the boot-time gate as the SAME string. It is resolved
# against RECIPE_DIR (your clone), so the path follows where you cloned the
# recipe instead of assuming a directory name.
SPEC_CONFIG_FILE="${SPEC_CONFIG_FILE:-${RECIPE_DIR:-$HOME/MiniMax-M3.1-Flash-TP3-3x-DGX-Spark}/config/spec-config.json}"

# --- the model names the API publishes.
# The true name and a stable alias. Clients that must survive a recipe
# switch pin the alias and never change.
SERVED_NAME=minimax31-flash
ALIAS_NAME=main

# --- collective networking.
# Subnet-aware rail matching for a per-link /24 triangle: NCCL_IB_SUBNET_
# AWARE_ROUTING + a prefix length that matches the per-link subnet,
# GID_AUTO=1, MERGE_NICS=0. With the compose-style statics alone the
# collective fails on this fabric; these four are the values that make a
# bare three-rank all-reduce pass.
#
# EVERY value in this block is READ: launch/start-tp3.sh passes each one into
# the container, so editing one here changes the collective. (They used to be
# a copy of what the launch hardcoded, which meant editing them did nothing.)
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_IB_GID_AUTO=1
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=1
NCCL_IB_ROCE_VERSION_NUM=2
# Channels: measured interior optimum on a three-rank dual-HCA ring.
# Do not copy a two-box lane's value here.
NCCL_MAX_NCHANNELS=8
# The control-plane interface (the fabric socket) and the CUDA cores.
# The DGX Spark management/fabric NIC. Override it if your box names it
# differently -- `ip -o link` lists the candidates.
NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-enP7s7}"
TP_SOCKET_IFNAME="${TP_SOCKET_IFNAME:-$NCCL_SOCKET_IFNAME}"
GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-$NCCL_SOCKET_IFNAME}"
CUTE_DSL_ARCH=sm_121a
VLLM_ENABLE_PCIE_ALLREDUCE=0

# --- the capture grid (the pin the profile and the rule share).
# The capture cap is the SAME number in the capture gate and in the
# acceptance rule, and it is HERE so there is one place to change it. It
# used to live only inside the rule, with the gate's copy unset -- so the
# gate's pinned-grid assertions never ran, and the two expectations could
# drift apart without either noticing.
#
# The cap is 128 because the decode hot path's uniform-decode sizes
# (4, 8, 16, 32, 64, 96, 128) are the decode descriptors, and the cap has
# to leave that set untouched: it is a coverage requirement, not a dial.
EXPECTED_CG_MAX=128
EXPECTED_CG_LIST=1,2,4,8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128
# The graph counts the pinned grid implies: piecewise (the pinned grid),
# full (the decode coverage, unchanged by the cap), dspark (the speculator's
# own graphs, untouched).
EXPECTED_CG_GRAPHS=19,17,14

# --- the memory guard (EDIT the floors for your own co-tenants).
# A unified-memory box has ONE pot: the GPU reservation and the request-side
# CPU staging draw from the same memory, and a GPU-side tenant is NOT free.
# The guard watches free host memory and kills ONLY this lane's container if
# it stays under the floor for a debounce count. The floors are per box: the
# head has the most room, the rank that also carries other services has the
# least. A single low sample is not enough -- one transient allocation must
# not kill a serving lane.
#
# These floors are READ: tools/guard-memory.sh takes the floor for THIS box
# from them, by the same hostname map the boot uses, when it is started
# without a --floor argument. An explicit --floor still wins.
GUARD_MIN_HEAD_MB=4096
GUARD_MIN_R1_MB=3584
GUARD_MIN_R2_MB=2432
GUARD_DEBOUNCE=3
